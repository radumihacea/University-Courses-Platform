<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Comunicarea cu backend-ul (REST + WebSocket) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reminderele inainte de ore: notificari (Android 13+) si alarme la ora exacta -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- usesCleartextTraffic: backend-ul ruleaza local pe http (fara https) -->
    <application
        android:name=".UcpApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UCPMobile"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.requests.MoveRequestActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.requests.MyRequestsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.availability.AvailabilityActivity"
            android:exported="false" />
        <activity
            android:name=".ui.optionals.OptionalsActivity"
            android:exported="false" />

        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />
    </application>

</manifest>
